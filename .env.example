# --- App ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_URL=
MAILGUN_API=
JWT_SECRET=
APP_URL=http://localhost:3000
# Host port the app container is published on
APP_PORT=3000
# Used when running the app outside docker (npm run dev).
# docker-compose overrides this for the app container.
DATABASE_URL=postgresql://ediblio:changeme@localhost:5434/ediblio

# --- Database (docker-compose) ---
POSTGRES_USER=ediblio
POSTGRES_DB=ediblio
POSTGRES_PASSWORD=changeme
# Host port the db is published on (5432/5433 are often taken by other local projects)
DB_PORT=5434
# Only needed if POSTGRES_PASSWORD contains URL-special characters (%, @, :, /, #, ...)
# POSTGRES_PASSWORD_URLENCODED=
